{
  // Cloudflare Workers：靜態資產（dist/）+ API（worker/src/index.ts）+ D1。
  // 本機：npm run dev:api（wrangler dev，含 D1 本機版）；部署：npm run deploy（需先徵得同意）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pinky",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about → /about/index.html；找不到就回 404 頁（不是 SPA fallback，避免公開頁被 App 蓋掉）
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // /api/* 一律進 Worker，其餘先找靜態檔
    "run_worker_first": ["/api/*", "/mcp", "/torch/*", "/torches", "/torches/", "/event/*", "/events", "/events/", "/sitemap.xml"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pinky", "database_id": "72f5b429-0301-4092-b353-1deffefdae47" }
  ],
  "vars": {
    // 店家註冊需要邀請碼；正式值用 `wrangler secret put MERCHANT_INVITE_CODE` 蓋掉
    "MERCHANT_INVITE_CODE": "dev-invite"
  },
  "routes": [
    { "pattern": "pinky.stream", "custom_domain": true },
    { "pattern": "www.pinky.stream", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
